{
    "name": "henzeb/laravel-pennant-cache",
    "description": "A Pennant driver built on Laravel's Cache",
    "keywords": [
        "henzeb",
        "laravel",
        "pennant",
        "feature flags",
        "feature toggles",
        "feature management",
        "cache",
        "cache driver",
        "cache store",
        "flags",
        "toggles"
    ],
    "homepage": "https://github.com/henzeb/laravel-pennant-cache",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Henze Berkheij",
            "email": "henzeberkheij@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/pennant": "^1.18.5"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/phpstan": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Henzeb\\Pennant\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-parallel": "vendor/bin/pest --parallel",
        "test-coverage-txt": "vendor/bin/pest --coverage",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage-html coverage",
        "test-dox": "vendor/bin/pest --testdox",
        "test-mutate": "XDEBUG_MODE=coverage vendor/bin/pest --mutate"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Henzeb\\Pennant\\Cache\\Providers\\PennantCacheServiceProvider"
            ]
        }
    }
}
